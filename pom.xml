<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <!--Identificacion del proyecto-->
  <groupId>com.graphics</groupId>
  <artifactId>opengl-java-class</artifactId>
  <packaging>jar</packaging>
  <version>1.0-SNAPSHOT</version>

  <name>opengl-java-class</name>
  <url>http://maven.apache.org</url>

  <!--
    Propiedades que se utilizan en el POM
    Aqui definir la version de Java, LWJGL
  -->

  <properties>
    <!--Version de Java para compilar -->
    <maven.compiler.source>17</maven.compiler.source>

    <!--Version del bytecode generado -->
    <maven.compiler.target>17</maven.compiler.target>

    <!--Version de LWJGL -->
    <lwjgl.version>3.3.3</lwjgl.version>

    <!--Clase que contiene un public static void main -->
    
    <main.class>com.graphics.Vehiculo</main.class>
    

    <!-- # NUEVA LÍNEA: define UTF-8 para eliminar las advertencias de Maven -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <!--Bibliotecas que el proyecto necesita para compilar y ejecutar-->
  <dependencies>

    <!--JUnit: biblioteca para escribir pruebas unitarias -->
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>3.8.1</version>
      <scope>test</scope>
    </dependency>

    <!--
      LWJGL: Son los binding de Java para OpenGL, GLFW
      Tres modulos principales:
       - lwjgl -> Es el nucleo para la carga de la biblioteca nativa
       - lwjgl-glfw -> Crear ventana, teclado, raton
       - lwjgl-opengl -> Llamadas a OpenGL
    -->

    <dependency>
      <groupId>org.lwjgl</groupId>
      <artifactId>lwjgl</artifactId>
      <version>${lwjgl.version}</version>
    </dependency>

    <dependency>
      <groupId>org.lwjgl</groupId>
      <artifactId>lwjgl-glfw</artifactId>
      <version>${lwjgl.version}</version>
    </dependency>

    <dependency>
      <groupId>org.lwjgl</groupId>
      <artifactId>lwjgl-opengl</artifactId>
      <version>${lwjgl.version}</version>
    </dependency>

    <!--
      # NUEVAS LÍNEAS
      Bibliotecas nativas necesarias para ejecutar LWJGL en Windows.
      Estas dependencias contienen los archivos .dll, como lwjgl.dll.
    -->

    <!-- # NUEVA DEPENDENCIA: archivos nativos del núcleo de LWJGL -->
    <dependency>
      <groupId>org.lwjgl</groupId>
      <artifactId>lwjgl</artifactId>
      <version>${lwjgl.version}</version>
      <classifier>natives-windows</classifier>
    </dependency>

    <!-- # NUEVA DEPENDENCIA: archivos nativos de GLFW -->
    <dependency>
      <groupId>org.lwjgl</groupId>
      <artifactId>lwjgl-glfw</artifactId>
      <version>${lwjgl.version}</version>
      <classifier>natives-windows</classifier>
    </dependency>

    <!-- # NUEVA DEPENDENCIA: archivos nativos de OpenGL -->
    <dependency>
      <groupId>org.lwjgl</groupId>
      <artifactId>lwjgl-opengl</artifactId>
      <version>${lwjgl.version}</version>
      <classifier>natives-windows</classifier>
    </dependency>

  </dependencies>

  <build>
    <plugins>

      <!--
        Aqui forzamos JAVA 17 para que el compilador use esa version
        aunque en el sistema haya otra
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>

        <configuration>
          <source>17</source>
          <target>17</target>
          <release>17</release>
        </configuration>
      </plugin>

      <!--
        exec-maven-plugin:
        Permite ejecutar la aplicacion con "mvn exec:java"
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.1.0</version>

        <!--
          # LÍNEAS ANTERIORES DESACTIVADAS

          Se desactivan porque -XstartOnFirstThread se utiliza principalmente
          en macOS y el proyecto se está ejecutando en Windows.

          También existía un error en ${main.Class}, porque la propiedad
          correcta es ${main.class}, con la letra "c" minúscula.

          <configuration>
            <executable>java</executable>
            <arguments>
              <argument>-XstartOnFirstThread</argument>
              <argument>-classpath</argument>
              <argument>${main.Class}</argument>
            </arguments>
          </configuration>
        -->

        <!-- # NUEVAS LÍNEAS: configuración correcta de la clase principal -->
        <configuration>
          <mainClass>${main.class}</mainClass>
        </configuration>
      </plugin>

    </plugins>
  </build>

</project>
